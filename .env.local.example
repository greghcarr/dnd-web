# Supabase credentials for the dndbnb account integration (sign-in + pulling
# the player's dndbnb characters into battles). Copy this file to `.env.local`
# and fill in the two values from the SAME Supabase project dndbnb uses
# (Supabase dashboard -> Settings -> API), so accounts and characters are shared.
#
# The anon/publishable key is safe in the client bundle (row-level security
# enforces per-user access); `.env.local` is gitignored regardless.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
